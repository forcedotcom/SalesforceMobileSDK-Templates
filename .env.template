# Eval Environment for SalesforceMobileSDK-Templates
#
# Quick start:  npm run eval:setup     (interactive wizard)
# Manual setup: cp .env.template .env  and fill in the values below.

# -- Credentials (required) ---------------------------------------------------

# Einstein LLM Gateway API key.
# Request via Slack #genai-nonprod-api-key-requests, or ask the ADK team
# to share the 1Password "lightning-gpt" vault with you.
EINSTEIN_API_KEY=

# LangSmith API key for eval tracing and scoring.
# See adk-core docs/public/core/eval/evals-langsmith-setup.md for setup.
LANGCHAIN_API_KEY=

# -- Paths (required) ---------------------------------------------------------

# Absolute path to the Agentforce Einstein GPT .vsix file.
# Download with: npm run eval:download-vsix
VIBES_VSIX_PATH=

# Absolute path to <repo>/skills (where android-mobile-sdk lives).
VIBES_SKILLS_DIR=

# Absolute path to <repo>/skills-eval/domains.
EVAL_DOMAINS_ROOT=

# Path to the vitest config (relative to repo root). adk-eval defaults to
# eval/vitest.config.ts; override since this repo uses skills-eval/.
EVAL_VITEST_CONFIG=skills-eval/vitest.config.ts

# Path to a directory containing rule definitions (.md files).
# We don't ship rules; point at any folder you own (can be empty).
VIBES_RULES_DIR=

# -- Salesforce org (required) ------------------------------------------------

# Org username. Authenticate first:
#   sf org login web --instance-url <url> --alias mobile-eval-org
SF_TARGET_ORG=

# -- Defaults (override only if you know why) --------------------------------

EINSTEIN_BASE_URL=https://bot-svc-llm.sfproxy.einstein2.test1-uswest2.aws.sfdc.cl/v1.0
EINSTEIN_MODEL=claude-4-sonnet
EINSTEIN_MODEL_PROVIDER=Anthropic
EINSTEIN_CLIENT_FEATURE_ID=EinsteinForDevelopers

LANGCHAIN_PROJECT=mobile-msdk-android-evals
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_CALLBACKS_BACKGROUND=true

TEST_MODEL=vibes-pw-default
